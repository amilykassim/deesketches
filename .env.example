# ── Database (Neon Postgres) ─────────────────────────────────────────────────
# Kept for the analytics events table and admin sessions only.
# Note records themselves live in blob storage (below) with 7-day TTL.
POSTGRES_URL=

# ── Storage / blob (notes + sketch images) ──────────────────────────────────
# Notes are stored as JSON blobs (one per note) under notes/<id>.json.
# Indexes live alongside under keys/ and emails/.
# Use "filesystem" in dev (writes under ./.storage/) and "vercel" in prod
# (uses Vercel Blob via @vercel/blob).
STORAGE_DRIVER=filesystem
BLOB_READ_WRITE_TOKEN=
# Must match how your Vercel Blob store is configured. "private" (default)
# means blobs are only readable via the SDK with a token; set to "public" if
# your store is configured for public access.
BLOB_ACCESS=private

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Optional. If RESEND_API_KEY is unset, all transactional emails are no-ops
# (creation/approval/rejection/opened) and the rest of the app keeps working.
RESEND_API_KEY=
EMAIL_FROM="Andiko <noreply@andiko.studio>"

# ── WhatsApp ────────────────────────────────────────────────────────────────
# Admin's WhatsApp number in international format, no `+`, no spaces or dashes
# (e.g. 250788123456). Used to build wa.me/<number>?text=... deep links from
# the reveal screen so senders can confirm payment with admin directly.
# Exposed to the client (NEXT_PUBLIC_*) because the link is rendered there.
NEXT_PUBLIC_ADMIN_WHATSAPP_NUMBER=

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=1234
ADMIN_SESSION_SECRET=
